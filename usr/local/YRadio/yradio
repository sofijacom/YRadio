fi
;;
*)
/bin/bash -c "mplay &"
if busybox timeout 2>&1 | grep -qo '\-t SECS'; then
busybox timeout -t $TIMEOUT /bin/bash -c time_out
else
busybox timeout $TIMEOUT /bin/bash -c time_out
fi

check_if_play

