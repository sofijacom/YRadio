#yad --center --title "Could not connect" --text "    Failed to connect to stream...    " --timeout=1 --button="Close!gtk-close"
#echo -e "Could not connect to stream\n\n\n\n\n" >> $nppipe
echo "Could not connect to stream" > $HOME/.yradio/tmp/metadata
#rm -f $HOME/.yradio/tmp/nowplay
exit
fi
;;
esac
	;;
	*)
	yad --center --text=" Not a valid playlist  " --button="Close"
	exit 
	;;
	esac
#rm -f $HOME/.yradio/tmp/nowplay

}
export -f play_url

