# Already ripping from this url
LFONT="<span size='medium' foreground='#C28300'><b>          *** StreamRipping ***</b></span>"
yad --window-icon=star --text " $LFONT \n Already ripping from: \n $URL" --title "Stream Ripping" --width 550 --center --fixed --button="Close:1"
