yad_alsa_audio(){

 # Toggle: if the volume window is already open, close it
 # (replaces the xdotool window handling, xdotool does not work on native Wayland windows)
 pkill -f 'yad --title=Volume Control' 2> /dev/null && return 1

if [ "$(pidof pulseaudio)" ] || [ "$(pidof pipewire)" ]; then
  if [ -n `which amixer` ]; then  # use amixer
card=$(amixer -D default scontrols | head -1 | cut -f2 -d"'")
card=$(echo \'$card\')
dev=default
export Vol=$(amixer -M get Master | awk -v FS="[[%]" '/%/ {print $2}')
  else  # use pactl if amixer not found
PA=YES
SINK=$( pactl list short sinks | sed -e 's,^\([0-9][0-9]*\)[^0-9].*,\1,' | head -n 1 )
export Vol=$(pactl list sinks | grep '^[[:space:]]Volume:' | head -n $(( $SINK + 1 )) | tail -n 1 | sed -e 's,.* \([0-9][0-9]*\)%.*,\1,')
  fi
  
else  # use amixer
card=$(amixer -D default scontrols | head -1 | cut -f2 -d"'")
card=$(echo \'$card\')
dev=default
export Vol=$(amixer -M get Master | awk -v FS="[[%]" '/%/ {print $2}')
fi
yad --title="Volume Control" --height=200 \
--no-buttons --borders="8" --mouse --close-on-unfocus --undecorated --on-top --scale  --vertical --sticky --print-partial  \
--value=$Vol | while read line; do
if [ "$PA" = "YES" ]; then
pactl set-sink-volume @DEFAULT_SINK@ "${line}%"; sleep 0.01;
else
amixer -D $dev sset "$card" ${line}%; sleep 0.01;
fi
done
}
export -f  yad_alsa_audio

# 'Now playing' as desktop notification (replaces the X11-only tray icon popup)
function notify_now() {
command -v notify-send > /dev/null || return
check_pid_mplayer
if [ -n "$pidmplayer" -o -n "$(grep "Stopped\|Paused\|Could not connect to stream" $HOME/.yradio/tmp/onclick 2> /dev/null)" ]; then
	TRACK="$(sed -n 1p $HOME/.yradio/tmp/onclick 2> /dev/null)"
	STATION="$(sed -n 2p $HOME/.yradio/tmp/onclick 2> /dev/null)"
	# tray menu header/tooltip = station + track (only when called from the main script, which holds the tray pipe on fd 5)
	[ -e /proc/$$/fd/5 ] && tray_menu "${STATION:-YRadio}${TRACK:+ - $TRACK}" >&5
	# do not repeat the same notification (notification daemons block floods)
	KEY="$STATION|$TRACK"
	[ "$1" != "force" ] && [ "$KEY" = "$(cat $HOME/.yradio/tmp/lastnotify 2> /dev/null)" ] && return
	echo "$KEY" > $HOME/.yradio/tmp/lastnotify
	# escape markup characters for the notification daemon
	TRACK="${TRACK//&/&amp;}"; TRACK="${TRACK//</&lt;}"; TRACK="${TRACK//>/&gt;}"
	STATION="${STATION//&/&amp;}"; STATION="${STATION//</&lt;}"; STATION="${STATION//>/&gt;}"
	# notify-send --app-name="YRadio" --icon="$LAUNCHDIR/icons/internetradio.png" --expire-time=6000 \
	notify-send --app-name="YRadio" --icon="$(ic internetradio.png audio-x-generic)" --expire-time=6000 \
		--hint=string:x-canonical-private-synchronous:yradio \
		--hint=string:x-dunst-stack-tag:yradio \
		"${STATION:-YRadio}" "$TRACK"
fi
}
export -f notify_now

# icon helper: use the file from the 'icons' folder next to the script, otherwise a theme icon
