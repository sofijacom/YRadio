# Tray icon: yradio_tray.py (Qt, native on Wayland) if PyQt6/PySide6 is installed, otherwise yad's tray icon.
# yad's tray icon is X11 only (XEmbed), so that fallback is started with GDK_BACKEND=x11 (XWayland). It only shows up if your desktop provides a system tray for such icons
# (KDE Plasma, XFCE, Cinnamon, MATE, ... or GNOME with an extension that supports it).
quit_from_tray () {
    kill $(cat "$HOME/.yradio/tmp/pid_list" 2> /dev/null) 2> /dev/null
}
