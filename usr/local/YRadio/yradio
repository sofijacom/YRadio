yadpidrip=$(ps -eo pid,cmd | grep "yad --text= Ripping from $(cat $HOME/.yradio/tmp/nowurl 2> /dev/null)" | grep -v "grep" | awk '{ print $1 }')
#kill $yadpidrip 2> /dev/null
#[ "`pidof mplayer`" ] && killall mplayer
fi
sleep 0.5
export URL="$1"
NAME="$2"
[ -z "$URL" ] && exit
echo "$URL" > $HOME/.yradio/tmp/nowurl
#echo -n "${1}|${2}|${3}" > $HOME/.yradio/tmp/nowurl
[ -z "$NAME" ] && NAME=$(cat $HOME/.yradio/tmp/nowplay 2> /dev/null)
echo "$NAME" > $HOME/.yradio/tmp/nowplay

check_if_play () {
if [ "$defplayer" = "mpv" ]; then
IFPLAYLIST=$(grep 'Audio' $HOME/.yradio/tmp/mplayer-output 2> /dev/null)
elif [ "$defplayer" = "mplayer" ]; then
IFPLAYLIST=$(grep 'Starting playback...' $HOME/.yradio/tmp/mplayer-output 2> /dev/null)
fi
}
export -f check_if_play

mplaylist () {
	if [ "$defplayer" = "mpv" ]; then
mpv "$URL"  --display-tags=icy-name,icy-title,icy-genre,icy-br --no-video 2> /dev/null | tee $HOME/.yradio/tmp/mplayer-output | grep --line-buffered "icy-title" | while read a; do echo "$a" | awk '{if ($0 ~ "icy-title:*") {$1="";$0=substr($0,2)}}1'; done | tee $HOME/.yradio/tmp/metadata	
	elif [ "$defplayer" = "mplayer" ]; then
mplayer -quiet -cache 320 -cache-min 8 -playlist "$URL" 2> /dev/null | grep --line-buffered -v 'Cache fill' | tee $HOME/.yradio/tmp/mplayer-output | grep --line-buffered "ICY" | while read a; do echo "$a" | awk -F " : |='|';" '/ICY Info/ {print $2}'; done | tee $HOME/.yradio/tmp/metadata
	fi
}
export -f mplaylist

mplay () {
	if [ "$defplayer" = "mpv" ]; then
mpv "$URL"  --display-tags=icy-name,icy-title,icy-genre,icy-br --no-video 2> /dev/null | tee $HOME/.yradio/tmp/mplayer-output | grep --line-buffered "icy-title" | while read a; do echo "$a" | awk '{if ($0 ~ "icy-title:*") {$1="";$0=substr($0,2)}}1'; done | tee $HOME/.yradio/tmp/metadata	
	elif [ "$defplayer" = "mplayer" ]; then	
mplayer -quiet -cache 320 -cache-min 8 "$URL" 2> /dev/null | grep --line-buffered -v 'Cache fill' | tee $HOME/.yradio/tmp/mplayer-output | grep --line-buffered "ICY" | while read a; do echo "$a" | awk -F " : |='|';" '/ICY Info/ {print $2}'; done | tee $HOME/.yradio/tmp/metadata
	fi

}
export -f mplay

# Check if starting playback appears in output, wait number of seconds, then give up:
TIMEOUT=40
time_out () {
check_if_play 
while [ -z "$IFPLAYLIST" ]; do
sleep 1
check_if_play
check_pid_mplayer
if [ "$IFPLAYLIST" ] || [ -z "$pidmplayer" ]; then
break
fi
done
}
export -f time_out

