# radio-browser search: downloads the result in many SMALL pages, several at the same time.
# (some providers cut connections to foreign servers after ~16 KB, so one big answer never arrives)
# Falls back to the next server if one fails. Tune with RB_STEP (rows per page, ~0.5 KB each), RB_PAR (parallel requests), RB_HOSTS
rb_curl () {
	local host dir step=${RB_STEP:-10} par=${RB_PAR:-6} off i f rows pid failed finished pids
	dir=$(mktemp -d)
	for host in ${RB_HOSTS:-de1 de2 all}; do
		rm -f "$dir"/p* "$dir"/e*; off=0; failed=0; finished=0
		while [ $finished -eq 0 ] && [ $failed -eq 0 ] && [ $off -lt 300000 ]; do
			pids=()
			for ((i=0; i<par; i++)); do
				( curl -sSf --compressed --connect-timeout 8 --max-time 20 --retry 3 --retry-delay 1 -X POST "$@" \
					--data-urlencode order=name --data-urlencode limit=$step --data-urlencode offset=$((off + i*step)) \
					-o "$dir/p$(printf %07d $((off + i*step)))" \
					"https://$host.api.radio-browser.info/csv/stations/search" 2> "$dir/e$(printf %07d $((off + i*step)))" ) &
				pids+=($!)
			done
			for pid in "${pids[@]}"; do wait $pid || failed=1; done
			[ $failed -eq 1 ] && break
			for ((i=0; i<par; i++)); do
				f="$dir/p$(printf %07d $((off + i*step)))"
				rows=$(wc -l < "$f")
				[ "$rows" -le "$step" ] && { finished=1; break; }   # not a full page (header + $step rows) = the end
			done
			off=$((off + par*step))
		done
		if [ $failed -eq 0 ]; then cat "$dir"/p*; rm -rf "$dir"; return 0; fi
		echo "radio-browser: $host.api.radio-browser.info failed (around offset $off), trying next server" >&2
		cat "$dir"/e* 2> /dev/null | sort -u | head -3 >&2   # show the real curl error(s)
	done
	rm -rf "$dir"; return 1
}
export -f rb_curl

