# message box without X11-only tools (xmessage/gxmessage don't work natively on Wayland)
msgbox () {
	if command -v yad > /dev/null; then
		yad --text="$1" --button="Close:0"
	elif command -v zenity > /dev/null; then
		zenity --info --text="$1"
	elif command -v notify-send > /dev/null; then
		notify-send "YRadio" "$1"
	else
		echo -e "$1" >&2
	fi
}

