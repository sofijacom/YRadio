    python3 "$LAUNCHDIR/yradio_tray.py" \
        --icon "$(ic internet_radio_48.png audio-radio-symbolic)" \
        --text "YRadio" \
        --command "bash -c 'notify_now force'" 2> "${YRADIO_TRAY_LOG:-/dev/null}" <&5 &
else
